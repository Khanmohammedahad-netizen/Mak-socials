# YouTube Data API OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=

# Email (notifications)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Snapchat
SNAPCHAT_EMAIL=

# Dashboard API auth — required, Flask will not start without it.
# Generate one locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAK_DASHBOARD_TOKEN=

# Feature flags — leave False. Do not flip without reading docs/AUDIT.md
# risk #1 (no rights record for background video/music) and risk #3
# (unauthenticated publish trigger) first.
ENABLE_LEGACY_AUTOPUBLISH=False
ENABLE_REDDIT_PIPELINE=False
